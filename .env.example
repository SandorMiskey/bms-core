#
# Example environment overrides for local development.
# Copy to `.env` (gitignored) and edit; the justfile loads it automatically.
# Every value here matches the justfile default, so an empty `.env` is fine.
# Values are literal: this file is not a shell script and `$VAR` is not expanded.

# Tooling {{{

BMS_MIGRATE=migrate
BMS_SQLITE3=sqlite3

# Homebrew keeps libpq keg-only, so `pg_dump` is not on PATH by default. The
# `opt` symlink tracks upgrades; a `Cellar` path pins one version and breaks on
# the next `brew upgrade`.
BMS_PG_DUMP=/opt/homebrew/opt/libpq/bin/pg_dump

# }}}
# Migration paths {{{

BMS_MIGRATIONS_SHARED=db/migrations/shared
BMS_MIGRATIONS_SQLITE=db/migrations/sqlite
BMS_MIGRATIONS_POSTGRES=db/migrations/postgres

# }}}
# Schema dump paths {{{

BMS_SCHEMA_SQLITE=db/schema/sqlite
BMS_SCHEMA_POSTGRES=db/schema/postgres

# }}}
# Database targets {{{

BMS_SQLITE_PATH=bms.db
BMS_SQLITE_DSN=sqlite3://bms.db

# Replace locally; never commit real credentials.
BMS_DSN_POSTGRES=postgres://user:pass@localhost:5432/bms?sslmode=disable

# }}}

# vim: set ts=4 sw=4 noet:
